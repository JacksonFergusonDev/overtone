{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overtone",
  "version": "0.1.0",
  "identifier": "dev.overtone.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Overtone",
        "width": 1280,
        "height": 860,
        "center": true,
        "minWidth": 840,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/spectrograms/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Jackson Ferguson",
    "category": "Music",
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
